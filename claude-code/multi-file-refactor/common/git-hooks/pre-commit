#!/usr/bin/env python3
"""
Pre-commit guard：禁止在 ``claude-code/multi-file-refactor/`` 下绕过共享
``FeishuClient`` 写飞书调用。

拦截两类违规：
1. 在 ``.py`` 文件里硬编码飞书 endpoint（``https://open.feishu.cn``）
2. 绕过 ``FeishuClient`` 自己拼 token / 调认证 API / 重复造 HTTP 工具

只扫 staged 内容（即将要被提交进索引的版本），不扫 working tree
未暂存改动。范围限定 ``claude-code/multi-file-refactor/`` 子树。

白名单：
- ``common/feishu/``：共享客户端本身（client / auth / http / bitable / __init__）
  允许定义默认 endpoint、token 路径、HTTP 工具实现。
- ``common/feishu/tests/``：测试 fixture。
- ``financial-automation/src/sync_bitable.py`` /
  ``bitable_attachment_uploader.py`` /
  ``bitable_session_writer.py``：
  第 17 课重构遗留的迁移中文件，给它们保留宽限；下一次迁移时再移除。
"""

from __future__ import annotations

import re
import subprocess
import sys
from pathlib import Path


# 仓库 git 根（agentic-ai/）— 由调用方通过 GIT_DIR 或当前 cwd 推断。
# 此脚本被 ``.git/hooks/pre-commit`` 调用，cwd 通常就是仓库根。
REPO_ROOT = Path(
    subprocess.run(
        ["git", "rev-parse", "--show-toplevel"],
        capture_output=True,
        text=True,
        check=True,
    ).stdout.strip()
)

SCAN_PREFIX = Path("claude-code/multi-file-refactor")

# 文件相对 git 根的路径 → 跳过检测。
# 共享客户端自身的实现是合法的；迁移中老模块给宽限期。
ALLOWED_PATHS = {
    "claude-code/multi-file-refactor/common/feishu/__init__.py",
    "claude-code/multi-file-refactor/common/feishu/client.py",
    "claude-code/multi-file-refactor/common/feishu/auth.py",
    "claude-code/multi-file-refactor/common/feishu/http.py",
    "claude-code/multi-file-refactor/common/feishu/bitable.py",
    "claude-code/multi-file-refactor/common/feishu/errors.py",
    "claude-code/multi-file-refactor/common/feishu/lobster_notify.py",
    "claude-code/multi-file-refactor/common/feishu/tests/test_auth.py",
    "claude-code/multi-file-refactor/common/feishu/tests/test_bitable.py",
    "claude-code/multi-file-refactor/common/feishu/tests/test_client.py",
    "claude-code/multi-file-refactor/common/feishu/tests/test_http.py",
    "claude-code/multi-file-refactor/common/feishu/tests/test_lobster_notify.py",
    "claude-code/multi-file-refactor/financial-automation/src/sync_bitable.py",
    "claude-code/multi-file-refactor/financial-automation/src/bitable_attachment_uploader.py",
    "claude-code/multi-file-refactor/financial-automation/src/bitable_session_writer.py",
    # Hook 脚本本身：里面写了 ``https?://open\.feishu\.cn`` 作为正则源码，
    # 不能让自检把自己的 pattern 当违规命中。
    "claude-code/multi-file-refactor/common/git-hooks/pre-commit",
}

# (regex, 违规标题, 修复建议)
BAD_PATTERNS: list[tuple[str, str, str]] = [
    (
        r"https?://open\.feishu\.cn",
        "硬编码飞书 endpoint",
        "endpoint 应走配置或 ``common.feishu.client.DEFAULT_ENDPOINT``，不要在业务代码里写死",
    ),
    (
        r"open-apis/auth/v3/tenant_access_token",
        "直接调飞书 tenant_access_token 认证 API",
        "用 ``FeishuClient(app_id=..., app_secret=...)``，认证由客户端内部处理",
    ),
    (
        r"open-apis/authen/(v1/access_token|v1/refresh_access_token)",
        "直接调飞书 OAuth access_token API",
        "用 ``common.feishu.auth`` 里的 ``exchange_oauth_code`` / ``refresh_oauth_token``，"
        "并通过 ``FeishuClient(user_access_token=...)`` 走共享客户端",
    ),
    (
        r"""["']Authorization["']\s*:\s*(?:f)?["']Bearer\b""",
        "手动拼 Authorization Bearer header",
        "``FeishuClient`` 内部已经处理 ``Bearer {token}``，业务代码不要再写"
        "（普通 / f-string 字面量都拦）",
    ),
    (
        r"def\s+(post_json|post_multipart|request_json|http_json_request)\s*\(",
        "重复实现 HTTP 工具函数",
        "用 ``common.feishu.http`` 里现成的 ``post_json`` / ``post_multipart`` / ``request_json``",
    ),
]


def _staged_files() -> list[str]:
    """所有 staged 且会进入 commit 的文件相对路径。"""
    result = subprocess.run(
        ["git", "diff", "--cached", "--name-only", "--diff-filter=ACMR"],
        capture_output=True,
        text=True,
        check=True,
        cwd=REPO_ROOT,
    )
    return [line.strip() for line in result.stdout.splitlines() if line.strip()]


def _staged_blob(rel_path: str) -> str | None:
    """读 staged 版本内容（index 里的 blob）。文件被删除返回 None。"""
    result = subprocess.run(
        ["git", "show", f":{rel_path}"],
        capture_output=True,
        text=True,
        cwd=REPO_ROOT,
    )
    if result.returncode != 0:
        return None
    return result.stdout


def _scan() -> list[dict[str, object]]:
    violations: list[dict[str, object]] = []
    for rel_path in _staged_files():
        # 限定扫描范围。
        rel = Path(rel_path)
        try:
            rel.relative_to(SCAN_PREFIX)
        except ValueError:
            continue
        if rel_path in ALLOWED_PATHS:
            continue
        if rel.suffix != ".py":
            continue

        content = _staged_blob(rel_path)
        if content is None:
            continue

        for pattern, title, hint in BAD_PATTERNS:
            for match in re.finditer(pattern, content):
                line_no = content.count("\n", 0, match.start()) + 1
                violations.append(
                    {
                        "file": rel_path,
                        "line": line_no,
                        "match": match.group(0),
                        "title": title,
                        "hint": hint,
                    }
                )
    return violations


def _print_report(violations: list[dict[str, object]]) -> None:
    bar = "=" * 72
    print(bar, file=sys.stderr)
    print("❌  Pre-commit 被拒：发现飞书调用违规", file=sys.stderr)
    print(bar, file=sys.stderr)
    for v in violations:
        print(
            f"\n  {v['file']}:{v['line']}  →  {v['title']}",
            file=sys.stderr,
        )
        print(f"    匹配: {v['match']!r}", file=sys.stderr)
        print(f"    建议: {v['hint']}", file=sys.stderr)
    print(
        "\n正确做法：在文件顶部把 ``common/`` 加进 ``sys.path``，"
        "然后 ``from feishu.client import FeishuClient``，\n"
        "通过 ``FeishuClient(app_id=..., app_secret=...)`` 或 "
        "``FeishuClient(user_access_token=...)`` 走共享客户端。",
        file=sys.stderr,
    )
    print(bar, file=sys.stderr)


def main() -> int:
    violations = _scan()
    if violations:
        _print_report(violations)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())